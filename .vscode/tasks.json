{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Release)",
            "type": "shell",
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}/tools/build_windows.ps1",
                    "-Configuration",
                    "Release",
                    "-Platform",
                    "x64"
                ],
                "problemMatcher": "$msCompile"
            },
            "linux": {
                "command": "make",
                "args": [
                    "-f",
                    "Makefile.linux",
                    "-j",
                    "CONFIG=release"
                ],
                "problemMatcher": "$gcc"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Build (Debug)",
            "type": "shell",
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}/tools/build_windows.ps1",
                    "-Configuration",
                    "Debug",
                    "-Platform",
                    "x64"
                ],
                "problemMatcher": "$msCompile"
            },
            "linux": {
                "command": "make",
                "args": [
                    "-f",
                    "Makefile.linux",
                    "-j",
                    "CONFIG=debug"
                ],
                "problemMatcher": "$gcc"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
